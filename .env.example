# ElementPay Dapp (Next.js) — server environment
#
# Never put FE_CLIENT_SECRET (or any aggregator secret) in NEXT_PUBLIC_* —
# those values are embedded in the browser bundle.

# NextAuth
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=change-me-to-a-long-random-string

# Aggregator bases (server-only). Include /api/v1.
NEXT_PRIVATE_ELEMENTPAY_SANDBOX_BASE=https://sandbox.elementpay.net/api/v1
NEXT_PRIVATE_ELEMENTPAY_LIVE_BASE=https://api.elementpay.net/api/v1
NEXT_PRIVATE_ELEMENTPAY_ENV=sandbox

# Optional single-base override (used when sandbox/live is not specified)
# AGGREGATOR_BASE_URL=https://sandbox.elementpay.net/api/v1

# Shared secret with aggregator (FE_CLIENT_SECRET on aggregator).
# Required when aggregator FE_CLIENT_SECRET_REQUIRED=true.
# Attached only by Next.js Route Handlers as X-FE-Client-Secret.
FE_CLIENT_SECRET=shared-secret-must-match-aggregator

# Notes for aggregator JWT Origin allowlist (JWT_ORIGIN_CHECK_REQUIRED):
# - Prod dapp Origin: https://dapp.elementpay.net
# - Local: add http://localhost:3000 to JWT_ALLOWED_ORIGINS for non-prod,
#   or rely on BFF + FE_CLIENT_SECRET (server-to-server skips Origin check)
